{
  "name": "{{ project_name }}",
  "image": "mcr.microsoft.com/devcontainers/python:{{ python_version }}",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "initializeCommand": "docker network create {{ project_name }} 2>/dev/null || true",
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--network={{ project_name }}"
  ],
  "mounts": [
    "source={{ project_name }}-venv,target=${containerWorkspaceFolder}/.venv,type=volume"
  ],
{%- if docker %}
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
{%- endif %}
  "postCreateCommand": "sudo chown vscode:vscode .venv && make setup",
  "customizations": {
    "vscode": {
      "settings": {
        "python.terminal.useEnvFile": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "streetsidesoftware.code-spell-checker",
        "ms-python.mypy-type-checker",
        "mhutchie.git-graph",
        "eamodio.gitlens",
        "tamasfe.even-better-toml",
        "usernamehw.errorlens"{% if continue %},
        "continue.continue"
{%- endif %}{% if docker %},
        "ms-azuretools.vscode-docker"
{%- endif %}{% if diagrams %},
        "jebbs.plantuml"
{%- endif %}
      ]
    }
  }
}
